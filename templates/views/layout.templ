package views

templ Layout(body templ.Component) {
	<!DOCTYPE html>
<html lang="en" x-data>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Aprendiendo con Otero Ediciones</title>
  <link rel="icon" type="image/svg" href="/static/assets/favicon.svg">
  <script src="https://unpkg.com/htmx.org@2.0.7"></script>
  <script src="https://unpkg.com/alpinejs" defer></script>
  <link href="/static/css/output.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <meta name="description" content="Plataforma educativa de Otero Ediciones.">
  <meta name="theme-color" content="#dc2626">
</head>
<body class="h-screen w-screen flex items-center justify-center bg-black relative">
	<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
	<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

	@body
	<script>
	function initFlatpickr() {
  flatpickr("#due-date", {
    dateFormat: "d/m/Y",
    altInput: true,
    altFormat: "d/m/Y",
    defaultDate: document.querySelector("#due-date")?.value || null,
    locale: flatpickr.l10ns.es,   // ✅ use the loaded Spanish locale
  });
}


 document.addEventListener("DOMContentLoaded", initFlatpickr);
 document.addEventListener("htmx:afterSwap", initFlatpickr);
</script>
<script>
function fileManager() {
  return {
    files: {},
    toDelete: {},
    uploading: false,
    isDirty: false,
    originalDescription: '',
    originalTitle: '',
    originalDate: '',

    init() {
      this.$watch('isDirty', value => this.toggleWarning(value));
      this.$watch('uploading', value => this.toggleWarning(value));
    },

    toggleWarning(condition) {
      if (condition) {
        window.addEventListener('beforeunload', this.beforeUnloadHandler);
      } else {
        window.removeEventListener('beforeunload', this.beforeUnloadHandler);
      }
    },

    beforeUnloadHandler(e) {
      e.preventDefault();
      e.returnValue = "Hay cambios sin guardar o archivos subiéndose. ¿Estás seguro de que quieres salir?";
      return e.returnValue;
    },

    checkDirty() {
      const hasPendingDeletions = Object.keys(this.toDelete).length > 0;
      const hasNewFiles = Object.values(this.files).some(v => v instanceof File);

      // Check Description (exists in both)
      const descField = this.$refs.descriptionField;
      const descChanged = descField ? descField.value !== this.originalDescription : false;

      // Check Title (only in Assignment Editor)
      const titleField = this.$refs.titleField;
      const titleChanged = titleField ? titleField.value !== this.originalTitle : false;

      // Check Due Date (only in Assignment Editor)
      const dateField = this.$refs.dateField;
      const dateChanged = dateField ? dateField.value !== this.originalDate : false;

      // Final check
      this.isDirty = hasPendingDeletions || hasNewFiles || descChanged || titleChanged || dateChanged;
    },

    resetState() {
      this.isDirty = false;
      this.uploading = false;
      this.toggleWarning(false);
    },

    initExisting(urls) {
      if (!urls) return;
      urls.forEach(url => {
        const name = url.split('/').pop();
        this.files[name] = url;
      });
      this.syncUploads();
      this.checkDirty();
    },

    addFiles(list) {
      Array.from(list).forEach(f => {
        this.files[f.name] = f;
      });
      this.syncUploads();
      this.checkDirty();
    },

    markForDeletion(name) {
      // 🆕 mark file to delete but don’t remove yet
      if (this.files[name]) {
        this.toDelete[name] = true;
      }
      this.checkDirty();
    },

    restore(name) {
      // allow user to undo delete (optional)
      delete this.toDelete[name];
      this.checkDirty();
    },

    finalizeDeletions() {
      // remove all truly deleted files before sending form
      for (const name in this.toDelete) {
        delete this.files[name];
      }
      this.toDelete = {};
      this.syncUploads();
    },

    syncUploads() {
      const dt = new DataTransfer();
      for (const v of Object.values(this.files)) {
        if (v instanceof File) dt.items.add(v);
      }
      this.$refs.uploads.files = dt.files;
    },
  };
}
</script>

<script>
function classManager() {
  return {
    classes: {},   // {id: name}
    toDelete: {},  // track marked-for-deletion

    initExisting(list) {
      if (!list || list.length === 0) return;
      if (typeof list === 'string') {
        try { list = JSON.parse(list); } catch { return; }
      }
      if (typeof list[0] === 'object') {
        list.forEach(c => this.classes[c.id || c.ID] = c.name || c.Name);
      } else {
        list.forEach(id => this.classes[id] = 'Desconocido');
      }
    },


    addClass(id, name = 'Nueva clase') {
      id = parseInt(id);
      if (!id || this.classes[id]) return;
      this.classes[id] = name;
    },

    markForDeletion(id) {
      if (this.classes[id]) this.toDelete[id] = true;
    },

    restore(id) {
      delete this.toDelete[id];
    },

    finalizeDeletions() {
      for (const id in this.toDelete) delete this.classes[id];
      this.toDelete = {};
    },

    // 🚀 Converts state into JSON string for backend
    getPayload() {
      const add = [];
      const keep = [];
      const del = [];

      for (const id in this.classes) {
        if (this.toDelete[id]) continue;
        // treat classes not marked for deletion as keep
        if (this.classes[id] === 'Nueva clase') add.push(parseInt(id));
        else keep.push(parseInt(id));
      }

      for (const id in this.toDelete) {
        del.push(parseInt(id));
      }

      return JSON.stringify({ add, keep, del });
    },

    // 🧠 Attach to form before submit (for HTMX)
    handleSubmit(event) {
      // just before HTMX serializes inputs
      const form = event.target;
      let hidden = form.querySelector('input[name="class_data"]');
      if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'class_data';
        form.appendChild(hidden);
      }
      hidden.value = this.getPayload(); // inject the JSON
    }

  };
}
</script>

<script>
function userManager() {
  return {
    // { "juanperez": { username:"juanperez", role:"student" }, ... }
    users: {},
    toDelete: {},

    initExisting(raw) {
      let list = raw;
      if (typeof raw === 'string') {
        try { list = JSON.parse(raw); } catch { return; }
      }
      if (!Array.isArray(list) || list.length === 0) return;

      list.forEach(u => {
        // Accept either full user objects or plain strings
        const username = typeof u === 'string'
          ? u
          : (u.username ?? u.Username ?? '').trim();
        if (!username) return;

        const role = typeof u === 'string'
          ? 'Desconocido'
          : (u.role ?? u.Role ?? 'Desconocido');

        this.users[username] = { username, role };
      });
    },

    // convenient list for x-for
    userList() { return Object.values(this.users); },

    addUser(username) {
      username = (username || '').trim();
      if (!username || this.users[username]) return;
      this.users[username] = { username, role: 'Pendiente' };
    },

    markForDeletion(username) {
      if (this.users[username]) this.toDelete[username] = true;
    },

    restore(username) {
      delete this.toDelete[username];
    },

    finalizeDeletions() {
      for (const username in this.toDelete) delete this.users[username];
      this.toDelete = {};
    },

    getPayload() {
      const keep = [];
      const del  = [];

      for (const username in this.users) {
        if (!this.toDelete[username]) keep.push(username);
      }
      for (const username in this.toDelete) del.push(username);

      // add[] is empty here because “adding” is also represented
      // by being present in keep[] and not present server-side yet.
      return JSON.stringify({ add: [], keep, del });
    },

    handleSubmit(e) {
      const form = e.target;
      let hidden = form.querySelector('input[name="user_data"]');
      if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'user_data';
        form.appendChild(hidden);
      }
      hidden.value = this.getPayload();
    }
  };
}
</script>


<script type="module">
  // Load pdf.js (module build) and point to the worker file
  import * as pdfjsLib from "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.2.67/pdf.min.mjs";
  pdfjsLib.GlobalWorkerOptions.workerSrc =
    "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.2.67/pdf.worker.min.mjs";

  // Keep sessions per container to clean up between swaps
  const sessions = new Map(); // containerId -> { pdf, observer }

  async function renderPDFInto(container, url) {
    const { getDocument } = pdfjsLib;
    const loadingEl = document.getElementById("pdf-loading");

    // Always show loading before any cleanup
    if (loadingEl) {
      loadingEl.classList.remove("hidden");
      loadingEl.querySelector("p").textContent = "Cargando PDF...";
    }

    try {
      // Cleanup previous session immediately to avoid visual delay
      const prev = sessions.get(container.id);
      if (prev) {
        try { prev.observer.disconnect(); } catch {}
        try { await prev.pdf?.destroy?.(); } catch {}
        sessions.delete(container.id);
      }

      // Clear previous pages early to show loading faster
      container.innerHTML = "<p class='text-gray-400 text-center py-8 italic'>Preparando visor...</p>";


      // Load PDF
      const task = getDocument({ url });
      const pdf = await task.promise;

      // Debounced renderer that scales pages to container width
      let debounce;
      const renderAllPages = async () => {
        clearTimeout(debounce);
        debounce = setTimeout(async () => {
          container.innerHTML = "";
          for (let n = 1; n <= pdf.numPages; n++) {
            const page = await pdf.getPage(n);

            const v1 = page.getViewport({ scale: 1 });
            const width = container.clientWidth || 800;
            const scale = width / v1.width;
            const viewport = page.getViewport({ scale });

            const canvas = document.createElement("canvas");
            canvas.width  = Math.floor(viewport.width);
            canvas.height = Math.floor(viewport.height);
            canvas.style.width = "100%";
            canvas.style.height = "auto";

            const ctx = canvas.getContext("2d", { alpha: false });
            container.appendChild(canvas);

            await page.render({ canvasContext: ctx, viewport }).promise;
          }
        }, 120);
      };

      await renderAllPages();

      // Re-render on resize
      const ro = new ResizeObserver(() => renderAllPages());
      ro.observe(container);
      sessions.set(container.id, { pdf, observer: ro });
    } catch (e) {
      console.error("PDF render failed:", e);
    } finally {
      if (loadingEl) loadingEl.classList.add("hidden");
    }


  }

  // Public init used by HTMX hooks and initial load
  window.initPDFViewer = async function (url, containerId = "pdf-pages") {
    const el = document.getElementById(containerId);
    if (!el || !url) return;
    try { await renderPDFInto(el, url); }
    catch (e) { console.error("PDF render failed:", e); }
  };

  // Initial load: if a container with data-pdf-src is present, render it
  document.addEventListener("DOMContentLoaded", () => {
    const el = document.querySelector("[data-pdf-src]");
    if (el) window.initPDFViewer(el.getAttribute("data-pdf-src"), el.id);
  });

  // After HTMX swaps: re-init if a PDF container was swapped in
  document.body.addEventListener("htmx:afterSwap", (e) => {
    const el = e.target.querySelector?.("[data-pdf-src]");
    if (el) window.initPDFViewer(el.getAttribute("data-pdf-src"), el.id);
  });
</script>

<script>
function subjectManager() {
  return {
    subjects: [],
    original: [],
    toDelete: {},
    newName: '',

    initExisting(raw) {
      let list = raw;
      if (typeof raw === 'string') {
        try { list = JSON.parse(raw); } catch { return; }
      }
      if (!Array.isArray(list)) return;
      this.subjects = list.slice();
      this.original = list.slice();
    },

    addSubject() {
      const name = (this.newName || '').trim();
      if (!name || this.subjects.includes(name)) return;
      this.subjects.push(name);
      this.newName = '';
    },

    markForDeletion(name) {
      if (this.subjects.includes(name)) this.toDelete[name] = true;
    },

    restore(name) {
      delete this.toDelete[name];
    },

    getPayload() {
      const add = [];
      const del = [];

      // Added
      for (const s of this.subjects) {
        if (!this.original.includes(s)) add.push(s);
      }

      // Deleted
      for (const o of this.original) {
        if (this.toDelete[o] || !this.subjects.includes(o)) del.push(o);
      }

      return JSON.stringify({ add, del });
    },

    handleSubmit(e) {
      const form = e.target;
      let hidden = form.querySelector('input[name="subject_data"]');
      if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'subject_data';
        form.appendChild(hidden);
      }
      hidden.value = this.getPayload();
    }
  };
}
</script>

<script>
function renameManager() {
  return {
    renameList: [],

    initExisting(raw) {
      let list = raw;
      if (typeof raw === 'string') {
        try { list = JSON.parse(raw); } catch { return; }
      }
      if (!Array.isArray(list)) return;
      this.renameList = list.map(s => ({ old: s, new: s }));
    },

    getPayload() {
      const rename = this.renameList
        .filter(item => item.new.trim() && item.new !== item.old)
        .map(item => ({ old: item.old, new: item.new.trim() }));
      return JSON.stringify({ rename });
    },

    handleSubmit(e) {
      const form = e.target;
      let hidden = form.querySelector('input[name="subject_data"]');
      if (!hidden) {
        hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'subject_data';
        form.appendChild(hidden);
      }
      hidden.value = this.getPayload();
    }
  };
}
</script>







</body>
</html>

}
