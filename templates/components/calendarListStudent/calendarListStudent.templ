package calendarListStudent

import (
	"frontend/database/models"
	"frontend/templates/components/assignment/assignmentSlotStudent"
)

templ CalendarListStudent(assignments []*models.Assignment, username string, grades []string) {
	<aside
		class="bg-white border-r border-gray-200 flex flex-col flex-1 min-h-0 lg:w-1/3 p-4"
	>
		<h3 class="text-lg font-semibold text-gray-900 mb-4">Asignaciones</h3>

		<ul id="assignments-calendar"
			class="space-y-2 flex-1 min-h-0 overflow-y-auto pr-1">
			if len(assignments) == 0 {
				<li class="text-gray-500 text-sm italic text-center py-4">
					No hay asignaciones este mes.
				</li>
			} else {
				for i, a := range assignments {
					@assignmentSlotStudent.AssignmentSlotStudent(a.Id, a, username, grades[i])
				}
			}
		</ul>
	</aside>
}
