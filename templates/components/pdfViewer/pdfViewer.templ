package pdfViewer

import (
	"frontend/database/models"
)

templ PDFViewer(currentPDF string, pdfList []*models.Asset) {
	<section
		id="pdf-viewer"
		class="flex-1 basis-0 min-h-0 bg-white border border-gray-200 shadow-sm rounded-lg flex flex-col lg:flex-row overflow-hidden"
	>
		<!-- Sidebar -->
		<aside
			class="w-full lg:w-1/4 border-b lg:border-b-0 lg:border-r border-gray-200 bg-gray-50 flex flex-col"
		>
			<div class="p-4 border-b border-gray-200 flex justify-between items-center">
				<h2 class="text-lg font-semibold text-gray-800 text-center lg:text-left flex-1">
					Documentos
				</h2>
			</div>

			<div class="flex-1 overflow-y-auto">
				<ul class="divide-y divide-gray-200 text-sm">
					for _, pdf := range pdfList {
						<li>
							<button
								hx-get={"/ver-pdf?src=" + pdf.Url}
								hx-target="#pdf-viewer-frame"
								hx-swap="outerHTML"
								class={"w-full text-left px-4 py-3 truncate transition hover:bg-red-50 cursor-pointer " + (func() string {
									if pdf.Url == currentPDF {
										return "bg-red-100 font-semibold text-red-700"
									}
									return "text-gray-700"
								}())}
							>
								{ pdf.Name }
							</button>
						</li>
					}
				</ul>
			</div>
		</aside>

		<!-- PDF Viewer -->
		<div class="flex-1 flex flex-col bg-gray-100">
			<div id="pdf-viewer-frame" class="flex-1 relative bg-gray-200">
				if currentPDF == "" {
					<div class="absolute inset-0 flex items-center justify-center">
						<p class="text-gray-500 italic text-center px-4">
							Ningún documento seleccionado.
						</p>
					</div>
				} else {
					<!-- 📄 Centered, fullscreen PDF iframe -->
					<div class="absolute inset-0 flex justify-center items-center bg-gray-100">
						<iframe
							src={currentPDF + "#toolbar=0&navpanes=0&scrollbar=0"}
							class="w-full h-full lg:rounded-none border-none shadow-inner bg-white"
							sandbox="allow-same-origin allow-scripts allow-top-navigation-by-user-activation"
							allow="clipboard-write 'none'; encrypted-media 'none';"
							oncontextmenu="return false"
						></iframe>

						<!-- Transparent overlay to discourage right-click save -->
						<div class="absolute inset-0 pointer-events-none bg-transparent"></div>
					</div>
				}
			</div>
		</div>
	</section>
}
