package adminHome

import (
	"frontend/templates/components/admin/optionSlot"
	"frontend/dto"
)

templ AdminHome(slotsInfo []*dto.AdminOption) {
	<!-- Content -->
	    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">

	      <!-- Class card -->
	      for _, item := range slotsInfo {
			@optionSlot.OptionSlot(item)
     }
	    </div>
}
