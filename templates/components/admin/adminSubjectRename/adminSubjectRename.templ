package adminSubjectRename

import (
	"encoding/json"
	"fmt"
)

templ AdminSubjectRename(subjects []string) {
	{{ subjectsJSONBytes, _ := json.Marshal(subjects) }}
	{{ subjectsJSON := string(subjectsJSONBytes) }}

<div id="subject-rename-wrapper"
     x-data="renameManager()"
     x-init={ fmt.Sprintf(`initExisting(%s)`, subjectsJSON) }
     class="bg-white rounded-lg shadow-md border border-gray-200 p-6 space-y-6 animate-fade-in max-w-3xl mx-auto">

  <!-- Header -->
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-semibold text-black tracking-tight">Renombrar materias</h2>
    <span class="text-sm text-gray-500 italic">Panel de administración</span>
  </div>

  <p class="text-gray-600 text-sm">
    Cambia los nombres de las materias existentes. No se crearán ni eliminarán registros, solo se actualizarán los nombres.
  </p>

  <!-- Form -->
  <form
    id="subject-rename-form"
    hx-post="/admin/subject/rename/update"
    hx-target="#rename-feedback"
    hx-swap="innerHTML"
    hx-trigger="submit"
    @submit="handleSubmit"
    class="space-y-6"
  >
    <div class="overflow-x-auto">
      <table class="table table-sm w-full border text-gray-800">
        <thead>
          <tr class="bg-gray-100 text-sm text-gray-700">
            <th>#</th><th>Nombre actual</th><th>Nuevo nombre</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="(item, index) in renameList" :key="item.old">
            <tr class="hover:bg-gray-50 text-sm">
              <td x-text="index + 1" class="w-10 text-center"></td>
              <td x-text="item.old" class="text-gray-800"></td>
              <td>
                <input x-model="item.new"
                       type="text"
                       class="input input-sm bg-white border-gray-300 text-black text-sm w-full focus:border-red-600 focus:ring-0 placeholder-gray-400"
                       placeholder="Nuevo nombre"/>
              </td>
            </tr>
          </template>

          <template x-if="renameList.length === 0">
            <tr>
              <td colspan="3" class="text-gray-400 italic text-center py-3">
                No hay materias registradas
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- Submit -->
    <div class="flex justify-end pt-4 border-t border-gray-100">
      <button type="submit"
              class="btn bg-green-600 hover:bg-green-700 text-white text-sm px-8">
        Guardar cambios
      </button>
    </div>
  </form>

  <!-- Feedback -->
  <div id="rename-feedback" class="text-sm text-gray-700"></div>
</div>
}
