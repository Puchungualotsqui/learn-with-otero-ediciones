package adminAssetManager

templ AdminAssetManager(subjects []string) {
<div
  id="asset-manager-wrapper"
  class="bg-white rounded-lg shadow-md border border-gray-200 p-6 space-y-6 animate-fade-in max-w-5xl mx-auto"
>
  <!-- Header -->
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-semibold text-black tracking-tight">
      Administrar recursos (PDFs)
    </h2>
    <div class="flex items-center gap-3">
      <span class="text-sm text-gray-500 italic">Panel de administración</span>
      <button
        type="button"
        class="btn btn-sm bg-yellow-500 hover:bg-yellow-600 text-black border-none shadow-sm"
        @click="
          const pwd = prompt('🔐 Ingrese la contraseña de administrador para continuar:');
          if (!pwd) return;
          if (pwd === 'otero2025') {
            if (confirm('¿Está seguro? Esto volverá a cargar todos los recursos y puede generar costos.')) {
              htmx.ajax('POST', '/admin/asset/refresh', {target:'#asset-list', swap:'innerHTML'});
            }
          } else {
            alert('Contraseña incorrecta');
          }
        "
      >
        Refrescar Recursos
      </button>
    </div>
  </div>

  <!-- Description -->
  <p class="text-gray-600 text-sm">
    Selecciona una materia y un grado para ver o subir los recursos PDF asociados.
  </p>

  <!-- Filters -->
  <form
    id="asset-filter-form"
    hx-get="/admin/asset/manage/list"
    hx-target="#asset-list"
    hx-swap="innerHTML"
    class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end border border-gray-100 rounded-lg p-4"
  >
    <div class="flex flex-col">
      <label class="text-sm text-gray-700 font-medium mb-1">Materia</label>
      <select name="subject" class="select select-bordered bg-white border-gray-300 text-sm text-black focus:border-red-600">
        <option disabled selected>Seleccionar...</option>
        for _, s := range subjects {
          <option value={ s }>{ s }</option>
        }
      </select>
    </div>

    <div class="flex flex-col">
      <label class="text-sm text-gray-700 font-medium mb-1">Grado</label>
      <select name="grade" class="select select-bordered bg-white border-gray-300 text-sm text-black focus:border-red-600">
        <option disabled selected>Seleccionar...</option>
        <optgroup label="Primaria">
          <option value="1primaria">1°</option>
          <option value="2primaria">2°</option>
          <option value="3primaria">3°</option>
          <option value="4primaria">4°</option>
          <option value="5primaria">5°</option>
          <option value="6primaria">6°</option>
        </optgroup>
        <optgroup label="Secundaria">
          <option value="1secundaria">1°</option>
          <option value="2secundaria">2°</option>
          <option value="3secundaria">3°</option>
          <option value="4secundaria">4°</option>
          <option value="5secundaria">5°</option>
          <option value="6secundaria">6°</option>
        </optgroup>
      </select>
    </div>

    <div class="flex justify-end md:col-span-1">
      <button
        type="submit"
        class="btn bg-red-600 hover:bg-red-700 text-white text-sm px-6 shadow-sm border-none h-10 w-full md:w-auto"
      >
        Buscar
      </button>
    </div>
  </form>

  <!-- Existing Files Table -->
  <div
    id="asset-list"
    class="mt-6 border border-gray-200 rounded-lg bg-white p-4 text-sm text-gray-700"
  >
    <p class="text-gray-400 italic text-center">Seleccione una materia y un grado.</p>
  </div>

</div>
}
