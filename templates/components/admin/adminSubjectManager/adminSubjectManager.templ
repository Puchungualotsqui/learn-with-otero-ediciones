package adminSubjectManager

import (
	"encoding/json"
	"fmt"
)

templ AdminSubjectManager(subjects []string, firstLoad bool) {
	{{ subjectsJSONBytes, _ := json.Marshal(subjects) }}
	{{ subjectsJSON := string(subjectsJSONBytes) }}

<div id="subject-manager-wrapper"
     x-data="subjectManager()"
     x-init={ fmt.Sprintf(`initExisting(%s)`, subjectsJSON) }
     class="bg-white rounded-lg shadow-md border border-gray-200 p-6 space-y-6 animate-fade-in max-w-3xl mx-auto"
     if !firstLoad {hx-swap-oob="true"}
>

  <!-- Header -->
  <div class="flex items-center justify-between">
    <h2 class="text-2xl font-semibold text-black tracking-tight">Administrar materias</h2>
    <span class="text-sm text-gray-500 italic">Panel de administración</span>
  </div>

  <p class="text-gray-600 text-sm">
    Aquí puedes agregar o eliminar materias disponibles.
  </p>

  <!-- Form -->
  <form
    id="subject-manage-form"
    hx-post="/admin/subject/manage/update"
    hx-target="#subjects-feedback"
    hx-swap="innerHTML"
    hx-trigger="submit"
    @submit="handleSubmit"
    class="space-y-6"
  >

    <!-- Add new subject -->
    <div class="flex gap-3 items-end border-b border-gray-100 pb-4">
      <div class="flex flex-col flex-grow">
        <label class="text-sm text-gray-700 font-medium mb-1">Nueva materia</label>
        <input x-model="newName"
               type="text"
               placeholder="Ej. Matemáticas"
               class="input input-bordered bg-white border-gray-300 text-black text-sm focus:border-red-600 focus:ring-0 placeholder-gray-400"/>
      </div>
      <button type="button"
              @click="addSubject"
              class="btn bg-red-600 hover:bg-red-700 text-white text-sm px-5">
        Agregar
      </button>
    </div>

    <!-- Table -->
    <div class="overflow-x-auto">
      <table class="table table-sm w-full border text-gray-800">
        <thead>
          <tr class="bg-gray-100 text-sm text-gray-700">
            <th>#</th><th>Nombre</th><th class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <template x-for="(subject, index) in subjects" :key="subject">
            <tr class="hover:bg-gray-50 text-sm">
              <td x-text="index + 1" class="w-10 text-center"></td>
              <td x-text="subject" class="text-gray-800"></td>
              <td class="text-center">
                <button type="button"
                        class="btn btn-xs"
                        :class="toDelete[subject] ? 'bg-yellow-400 text-black' : 'bg-red-600 hover:bg-red-700 text-white'"
                        x-text="toDelete[subject] ? 'Restaurar' : 'Eliminar'"
                        @click="toDelete[subject] ? restore(subject) : markForDeletion(subject)">
                </button>
              </td>
            </tr>
          </template>

          <template x-if="subjects.length === 0">
            <tr>
              <td colspan="3" class="text-gray-400 italic text-center py-3">
                No hay materias registradas
              </td>
            </tr>
          </template>
        </tbody>
      </table>
    </div>

    <!-- Submit -->
    <div class="flex justify-end pt-4 border-t border-gray-100">
      <button type="submit"
              class="btn bg-green-600 hover:bg-green-700 text-white text-sm px-8">
        Guardar cambios
      </button>
    </div>
  </form>

  <!-- Feedback -->
  <div id="subjects-feedback" class="text-sm text-gray-700"></div>
</div>
}
