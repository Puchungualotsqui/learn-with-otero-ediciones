package adminClassCreate

templ AdminCreateClass(subjects []string) {
	<section class="bg-white rounded-lg shadow-sm p-6 space-y-4">
	    <h2 class="text-xl font-semibold text-gray-800 mb-2">Crear Clase</h2>
	    <p class="text-gray-600 text-sm mb-4">
	      Completa los datos de la nueva clase. El ID se asignará automáticamente.
	    </p>

	    <form
	      hx-post="/admin/class/create"
	      hx-target="#create-class-feedback"
	      hx-swap="outerHTML"
	      hx-on="htmx:afterSwap: this.reset()"
	      class="grid grid-cols-1 md:grid-cols-2 gap-4"
	    >
	      <!-- Nombre -->
	      <div class="form-control">
	        <label class="label">
	          <span class="label-text text-gray-700 font-medium">Nombre</span>
	        </label>
	        <input
	          type="text"
	          name="name"
	          placeholder="Ej: Literatura 4°A"
	          class="input input-bordered bg-white border-gray-300 text-gray-800
	                 focus:border-red-400 focus:ring-1 focus:ring-red-400
	                 placeholder-gray-400 text-sm"
	          required
	        />
	      </div>

	      <!-- Asignatura -->
	      <div class="form-control">
	        <label class="label">
	          <span class="label-text text-gray-700 font-medium">Asignatura</span>
	        </label>
	        <select
	          name="subject"
	          class="select select-bordered bg-white border-gray-300 text-gray-800
	                 focus:border-red-400 focus:ring-1 focus:ring-red-400 text-sm"
	          required
	        >
	          <option disabled selected>Seleccionar asignatura...</option>
	          for _, s := range subjects {
	            <option value={ s }>{ s }</option>
	          }
	        </select>
	      </div>

	      <!-- Descripción -->
	      <div class="form-control md:col-span-2">
	        <label class="label">
	          <span class="label-text text-gray-700 font-medium">Descripción</span>
	        </label>
	        <textarea
	          name="description"
	          placeholder="Ej: Clase con el profe Hugo"
	          rows="3"
	          class="textarea textarea-bordered bg-white border-gray-300 text-gray-800
	                 focus:border-red-400 focus:ring-1 focus:ring-red-400
	                 placeholder-gray-400 text-sm"
	          required
	        ></textarea>
	      </div>

	      <!-- Grado -->
	      <div class="form-control md:col-span-2">
	        <label class="label">
	          <span class="label-text text-gray-700 font-medium">Grado</span>
	        </label>
	        <select
	          name="grade"
	          class="select select-bordered bg-white border-gray-300 text-gray-800
	                 focus:border-red-400 focus:ring-1 focus:ring-red-400 text-sm"
	          required
	        >
	          <option disabled selected>Seleccionar grado...</option>
	          <optgroup label="Primaria">
	            <option value="1primaria">1° de Primaria</option>
	            <option value="2primaria">2° de Primaria</option>
	            <option value="3primaria">3° de Primaria</option>
	            <option value="4primaria">4° de Primaria</option>
	            <option value="5primaria">5° de Primaria</option>
	            <option value="6primaria">6° de Primaria</option>
	          </optgroup>
	          <optgroup label="Secundaria">
	            <option value="1secundaria">1° de Secundaria</option>
	            <option value="2secundaria">2° de Secundaria</option>
	            <option value="3secundaria">3° de Secundaria</option>
	            <option value="4secundaria">4° de Secundaria</option>
	            <option value="5secundaria">5° de Secundaria</option>
	            <option value="6secundaria">6° de Secundaria</option>
	          </optgroup>
	        </select>
	      </div>

	      <!-- Botón -->
	      <div class="md:col-span-2 flex justify-end">
	        <button
	          type="submit"
	          class="btn bg-red-600 text-white hover:bg-red-700 text-sm px-6"
	        >
	          Crear Clase
	        </button>
	      </div>
	    </form>

	    <!-- Feedback -->
	    <div id="create-class-feedback"></div>
	</section>
}
