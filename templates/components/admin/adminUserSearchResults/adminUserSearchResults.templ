package adminUserSearchResults

import (
	"frontend/database/models"
)

templ AdminUserSearchResults(users []*models.User) {
<table class="table table-sm w-full border text-gray-800">
  <thead>
    <tr class="bg-gray-100 text-sm text-gray-700">
      <th>Usuario</th><th>Nombre</th><th>Colegio</th>
      <th>Grado</th><th>Rol</th>
    </tr>
  </thead>
  <tbody>
    if len(users) == 0 {
      <tr><td colspan="6" class="text-center text-gray-400 italic py-3">
        No se encontraron resultados
      </td></tr>
    } else {
      for _, u := range users {
        <tr class="hover:bg-gray-50 text-sm">
          <td>{ u.Username }</td>
          <td>{ u.FirstName } { u.LastName }</td>
          <td>{ u.School }</td>
          <td>{ u.Grade }</td>
          <td>{ u.Role }</td>
        </tr>
      }
    }
  </tbody>
</table>
}
